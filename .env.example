# Example only. This app does not auto-load .env files.
# Set in PowerShell before starting the backend:
# $env:TENCENTCLOUD_WSA_APIKEY = <your local secret>
# Do not put this key in VITE_* variables or frontend source.
TENCENTCLOUD_WSA_APIKEY=
# Standard Tencent Cloud TC3 alternative; backend process only:
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_TOKEN=
SEARCHPRO_AUTH_MODE=auto

# Independent contextual decision model. Never set these as VITE_* variables.
DECISION_PROVIDER=tokenhub
TOKENHUB_API_KEY=
TOKENHUB_MODEL=hy4-preview
TOKENHUB_REGION=guangzhou
